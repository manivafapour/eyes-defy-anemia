data/raw/
data/processed/images/
# outputs/ was reorganized 2026-07-31 from flat outputs/{checkpoints,logs,plots}/
# into one subfolder per (architecture, tissue_type) combo, e.g.
# outputs/resnet18_palpebral_v2/best_resnet18_palpebral_v2.pth -- so the
# checkpoint-ignore rule now matches by extension within any combo folder,
# not by a fixed "checkpoints/" directory name.
outputs/*/*.pth
__pycache__/
*.pyc
*.zip

# Dedicated pipelines under datapreparepipeline/ (e.g. efficientnet_b0_forniceal_5fold_cv/)
# each have their own outputs/checkpoints/ -- the pattern above is anchored
# to this .gitignore's own directory (classification/) and does NOT match
# these deeper, nested locations, so each needs its own entry.
datapreparepipeline/efficientnet_b0_forniceal_5fold_cv/outputs/checkpoints/
