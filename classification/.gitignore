data/raw/
data/processed/images/
# outputs/ was reorganized 2026-07-31 from flat outputs/{checkpoints,logs,plots}/
# into one subfolder per (architecture, tissue_type) combo, e.g.
# outputs/resnet18_palpebral_v2/best_resnet18_palpebral_v2.pth -- so the
# checkpoint-ignore rule now matches by extension within any combo folder,
# not by a fixed "checkpoints/" directory name.
outputs/*/*.pth
__pycache__/
*.pyc
*.zip

# Dedicated pipelines under datapreparepipeline/ (e.g. efficientnet_b0_forniceal_5fold_cv/)
# each have their own outputs/checkpoints/ -- the pattern above is anchored
# to this .gitignore's own directory (classification/) and does NOT match
# these deeper, nested locations, so each needs its own entry.
datapreparepipeline/efficientnet_b0_forniceal_5fold_cv/outputs/checkpoints/

# Same reason: v2_clean_scripts/outputs/ (Kaggle results downloaded/organized
# there directly, 2026-08-02) is a deeper, separate location the anchored
# outputs/*/*.pth pattern above does not reach.
v2_clean_scripts/outputs/*/*.pth
v2_clean_scripts/outputs/checkpoints/

# Same reason again: classification/outputs/ (the original v2 sweep's results)
# was manually relocated to v2_scripts/outputs/ by the project author,
# 2026-08-02, to sit alongside the scripts that produced it (mirroring
# v2_clean_scripts/ above) -- another deeper location the anchored pattern
# doesn't reach, and this one actually had 18 untracked checkpoints in it.
v2_scripts/outputs/*/*.pth
v2_scripts/outputs/checkpoints/

# Pre-emptive, same anchoring reason (this is the 5th place it applies):
# step1_cv_harness/ is deliberately designed to write NO checkpoints -- Step 1
# needs out-of-fold predictions, not weights -- so its outputs/ is all small
# tracked text (oof_predictions.csv, fold_manifest.json, cv_metrics.json, and
# the frozen baseline, all of which Steps 2-5 read). This entry exists only so
# that if checkpoint saving is ever added there, it cannot be staged by
# accident before someone notices the anchored pattern above never reached it.
step1_cv_harness/outputs/*/*.pth
